menu "Minibox"

config MINIBOX_HARDWARE_TEST
    bool "Boot the original hardware diagnostics instead of the LVGL apps"
    default n
    help
        Run the original screen, keys, joystick, PCF8563 and microphone test.
        Leave disabled for chat, radio, settings and games.

config MINIBOX_BUTTON_ACTIVE_LOW
    bool "GPIO4/5/6/7 buttons pressed at low level (internal pull-ups)"
    default y
    help
        Direct-solder mechanical switches require this option enabled.
        Each switch shorts its GPIO to common ground when pressed.
        Disable for modules that output a high level when pressed.

config MINIBOX_RADIO_TEST
    bool "Speaker test: play Donggan 101 instead of microphone recording"
    default n
    help
        Connect to the configured Wi-Fi and continuously play Donggan 101.
        Microphone recording is disabled to avoid sharing the I2S clocks.
        Buttons, joystick, RTC and display remain active.

config MINIBOX_WIFI_SSID
    string "Radio Wi-Fi SSID"
    default "MiaoHome"

config MINIBOX_WIFI_PASSWORD
    string "Radio Wi-Fi password (local sdkconfig only)"
    default ""
    help
        Set locally with menuconfig. Never put credentials in sdkconfig.defaults.

config MINIBOX_JOYSTICK_X_PIN
    int "Joystick VRx GPIO (ADC1)"
    range 1 2
    default 1

config MINIBOX_JOYSTICK_Y_PIN
    int "Joystick VRy GPIO (ADC1)"
    range 1 2
    default 2

config MINIBOX_JOYSTICK_X_INVERTED
    bool "Invert joystick X"
    default y

config MINIBOX_JOYSTICK_Y_INVERTED
    bool "Invert joystick Y"
    default n

config MINIBOX_AMP_GAIN_12DB
    bool "MAX98357 GAIN: drive GPIO42 low for 12 dB (off = floating, 9 dB)"
    default n
    help
        GPIO42 controls amplifier gain, not the unused joystick switch.
        Enable to drive GAIN low for approximately 12 dB.
        Disable to leave GAIN high-impedance without pull-ups or pull-downs
        for approximately 9 dB. SD/MODE remains on GPIO47.

config MINIBOX_LCD_SPI_MHZ
    int "ST7796 SPI clock (MHz)"
    range 1 40
    default 40

config MINIBOX_LCD_BGR
    bool "ST7796 BGR color order"
    default y

config MINIBOX_LCD_INVERTED
    bool "ST7796 display inversion"
    default n

config MINIBOX_LCD_BACKLIGHT_ACTIVE_LOW
    bool "Backlight active low"
    default n

config MINIBOX_LCD_STATIC_TEST
    bool "Diagnostic: freeze display after first joystick frame"
    default n
    help
        Stop all screen writes after the first test frame.
        Joystick sampling and serial logs continue. Use this to distinguish
        SPI refresh artifacts from whole-panel/backlight fluctuations.

endmenu
