menu "Minibox hardware test"

config MINIBOX_BUTTON_ACTIVE_LOW
    bool "GPIO40/41/42 buttons pressed at low level (internal pull-ups)"
    default y
    help
        Use 3.3 V button modules with active-low OUT and common ground.
        Disable for modules that output a high level when pressed.

config MINIBOX_WIFI_SSID
    string "Radio Wi-Fi SSID"
    default "MiaoHome"

config MINIBOX_WIFI_PASSWORD
    string "Radio Wi-Fi password (local sdkconfig only)"
    default ""
    help
        Set locally with menuconfig. Never put credentials in sdkconfig.defaults.

config MINIBOX_JOYSTICK_X_PIN
    int "Joystick VRx GPIO (ADC1)"
    range 1 6
    default 4

config MINIBOX_JOYSTICK_Y_PIN
    int "Joystick VRy GPIO (ADC1)"
    range 1 6
    default 5

config MINIBOX_JOYSTICK_K_PIN
    int "Joystick K GPIO"
    range 1 6
    default 6

config MINIBOX_JOYSTICK_X_INVERTED
    bool "Invert joystick X"
    default y

config MINIBOX_JOYSTICK_Y_INVERTED
    bool "Invert joystick Y"
    default n

config MINIBOX_JOYSTICK_K_ACTIVE_LOW
    bool "Joystick K pressed at low level (off = active high)"
    default n

config MINIBOX_AMP_GAIN_12DB
    bool "MAX98357 GAIN: drive GPIO8 low for 12 dB (off = floating, 9 dB)"
    default n

config MINIBOX_LCD_SPI_MHZ
    int "ST7796 SPI clock (MHz)"
    range 1 40
    default 40

config MINIBOX_LCD_BGR
    bool "ST7796 BGR color order"
    default y

config MINIBOX_LCD_INVERTED
    bool "ST7796 display inversion"
    default n

config MINIBOX_LCD_BACKLIGHT_ACTIVE_LOW
    bool "Backlight active low"
    default n

config MINIBOX_LCD_STATIC_TEST
    bool "Diagnostic: freeze display after first joystick frame"
    default n
    help
        Stop all screen writes after the first test frame.
        Joystick sampling and serial logs continue. Use this to distinguish
        SPI refresh artifacts from whole-panel/backlight fluctuations.

endmenu
